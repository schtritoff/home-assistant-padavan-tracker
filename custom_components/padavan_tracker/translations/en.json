    "step": {
      "init": {
        "title": "Padavan-ng tracker options",
        "data": {
          "scan_interval": "Scan interval (seconds, 5-3600; default 300)",
          "consider_home": "Consider home (seconds after last seen before a device is not home; default 180)",
