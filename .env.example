# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.
# NOTE: this file is only for local testing and development (the dev scripts
# in _dev/); the Home Assistant integration itself is configured via the UI.

# --- Router (padavan web interface) ---
host=192.168.1.1
user=admin
pass=changeme

# --- Home Assistant (for testing against a real instance) ---
ha_url=https://your-homeassistant.example.net
ha_token=your_long_lived_access_token
